{
  "$schema": "../node_modules/@tauri-apps/cli/schema/acl/capability.json",
  "identifier": "default",
  "description": "Default capability for Company Manager. Arquivos: anexos e backup em $APPDATA/$APPCONFIG; importar/exportar em Downloads, Documentos e Mesa (e no caminho escolhido no diálogo).",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "dialog:allow-confirm",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-remove",
    "fs:allow-copy-file",
    "fs:allow-rename",
    "fs:allow-stat",
    "fs:allow-read-dir",
    "fs:allow-mkdir",
    "fs:allow-exists",
    "fs:scope-appdata-recursive",
    "fs:scope-appconfig-recursive",
    "fs:scope-download-recursive",
    "fs:scope-document-recursive",
    "fs:scope-desktop-recursive",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-close"
  ]
}
