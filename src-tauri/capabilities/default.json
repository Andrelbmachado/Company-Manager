{
  "$schema": "../node_modules/@tauri-apps/cli/schema/acl/capability.json",
  "identifier": "default",
  "description": "Default capability for Company Manager. Arquivos: ler, gravar, copiar, renomear e apagar só em $APPDATA (anexos, backup); ler também em Downloads e Documentos. Pastas de nuvem dos Documentos (iCloud Drive, ~/Library/CloudStorage do Google Drive/OneDrive/Dropbox e as pastas antigas ~/Google Drive, ~/OneDrive, ~/Dropbox): ler, listar, lstat e gravar arquivo novo (o app nunca sobrescreve nem apaga lá). Fora disso, só o caminho escolhido pela pessoa em dialog.open/save (o diálogo libera esse caminho).",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:webview:allow-print",
    "shell:allow-open",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://*" }, { "url": "http://*" }]
    },
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "dialog:allow-confirm",
    {
      "identifier": "fs:allow-read-file",
      "allow": [{ "path": "$APPDATA" }, { "path": "$APPDATA/**" }, { "path": "$DOWNLOAD/**" }, { "path": "$DOCUMENT/**" }, { "path": "$HOME/Library/Mobile Documents/com~apple~CloudDocs/**" }, { "path": "$HOME/Library/CloudStorage/**" }, { "path": "$HOME/Google Drive/**" }, { "path": "$HOME/OneDrive/**" }, { "path": "$HOME/Dropbox/**" }]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [{ "path": "$APPDATA" }, { "path": "$APPDATA/**" }, { "path": "$DOWNLOAD/**" }, { "path": "$DOCUMENT/**" }]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [{ "path": "$APPDATA" }, { "path": "$APPDATA/**" }, { "path": "$DOWNLOAD" }, { "path": "$DOWNLOAD/**" }, { "path": "$DOCUMENT" }, { "path": "$DOCUMENT/**" }, { "path": "$HOME/Library/Mobile Documents/com~apple~CloudDocs" }, { "path": "$HOME/Library/Mobile Documents/com~apple~CloudDocs/**" }, { "path": "$HOME/Library/CloudStorage" }, { "path": "$HOME/Library/CloudStorage/**" }, { "path": "$HOME/Google Drive" }, { "path": "$HOME/Google Drive/**" }, { "path": "$HOME/OneDrive" }, { "path": "$HOME/OneDrive/**" }, { "path": "$HOME/Dropbox" }, { "path": "$HOME/Dropbox/**" }]
    },
    {
      "identifier": "fs:allow-stat",
      "allow": [{ "path": "$APPDATA" }, { "path": "$APPDATA/**" }, { "path": "$DOWNLOAD/**" }, { "path": "$DOCUMENT/**" }, { "path": "$HOME/Library/Mobile Documents/com~apple~CloudDocs" }, { "path": "$HOME/Library/Mobile Documents/com~apple~CloudDocs/**" }, { "path": "$HOME/Library/CloudStorage" }, { "path": "$HOME/Library/CloudStorage/**" }, { "path": "$HOME/Google Drive" }, { "path": "$HOME/Google Drive/**" }, { "path": "$HOME/OneDrive" }, { "path": "$HOME/OneDrive/**" }, { "path": "$HOME/Dropbox" }, { "path": "$HOME/Dropbox/**" }]
    },
    {
      "identifier": "fs:allow-lstat",
      "allow": [{ "path": "$HOME/Library/Mobile Documents/com~apple~CloudDocs" }, { "path": "$HOME/Library/Mobile Documents/com~apple~CloudDocs/**" }, { "path": "$HOME/Library/CloudStorage" }, { "path": "$HOME/Library/CloudStorage/**" }, { "path": "$HOME/Google Drive" }, { "path": "$HOME/Google Drive/**" }, { "path": "$HOME/OneDrive" }, { "path": "$HOME/OneDrive/**" }, { "path": "$HOME/Dropbox" }, { "path": "$HOME/Dropbox/**" }]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [{ "path": "$APPDATA" }, { "path": "$APPDATA/**" }, { "path": "$DOWNLOAD/**" }, { "path": "$DOCUMENT/**" }, { "path": "$HOME/Library/Mobile Documents/com~apple~CloudDocs" }, { "path": "$HOME/Library/Mobile Documents/com~apple~CloudDocs/**" }, { "path": "$HOME/Library/CloudStorage" }, { "path": "$HOME/Library/CloudStorage/**" }, { "path": "$HOME/Google Drive" }, { "path": "$HOME/Google Drive/**" }, { "path": "$HOME/OneDrive" }, { "path": "$HOME/OneDrive/**" }, { "path": "$HOME/Dropbox" }, { "path": "$HOME/Dropbox/**" }]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [{ "path": "$APPDATA" }, { "path": "$APPDATA/**" }]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [{ "path": "$APPDATA/**" }, { "path": "$HOME/Library/Mobile Documents/com~apple~CloudDocs/**" }, { "path": "$HOME/Library/CloudStorage/**" }, { "path": "$HOME/Google Drive/**" }, { "path": "$HOME/OneDrive/**" }, { "path": "$HOME/Dropbox/**" }]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [{ "path": "$APPDATA/**" }]
    },
    {
      "identifier": "fs:allow-copy-file",
      "allow": [{ "path": "$APPDATA/**" }]
    },
    {
      "identifier": "fs:allow-rename",
      "allow": [{ "path": "$APPDATA/**" }]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [{ "path": "$APPDATA/**" }]
    },
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-close"
  ]
}
